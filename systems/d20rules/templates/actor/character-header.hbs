<section class="{{cssClass}} {{actor.type}}-header flexcol"
	autocomplete="off">
	<div class=" header-container flexleft">
		<div class="profile">
			<img class="profile-img"
				src="{{document.img}}"
				{{#if editable}}
				data-action="editImage"
				{{else}}
				data-action=""
				{{/if}}
				data-edit="img"
				data-type="Image"
				alt="Portrait"
				title="{{document.name}}"
				height="100"
				width="100" />
			{{! Name }}
			{{#if editable}}
				<input type="text"
					id="name"
					name="name"
					class="document-name uninput"
					value="{{actor.name}}"
					data-dtype="String" />
			{{else}}
				<div id="name"
					class="document-name">{{actor.name}}
				</div>
			{{/if}}
		</div>

		<div class="{{actor.type}}-stats flexleft">
			<div class="stat-group">
				{{#each stats}}
					<div>{{@key}}: </div>
				{{/each}}
			</div>
			<div class="stat-values">
				{{#if creation}}
					{{#each stats as |stat key|}}
						<input type="text"
							class="stat"
							name="system.stats.{{key}}"
							autocomplete="off"
							class="document-name uninput"
							value="{{stat}}"
							data-dtype="Number" />
					{{/each}}
				{{else}}
					{{#each stats as | stat|}}
						<div class="stat">{{stat}}</div>
					{{/each}}
				{{/if}}
			</div>
		</div>

	</div>
</section>