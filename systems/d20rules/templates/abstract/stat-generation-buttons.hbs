<section class="stat-gen-buttons {{cssClass}} {{actor.type}} flexcol"
	autocomplete="off">

	<div>Choose a stat generation method</div>
	<div>-------------------------------</div>
	<div>
		<button type="button"
			data-action="rollMethod"
			data-type="randomOrdered">Random Roll In Order</button>
	</div>
	<div>
		<button type="button"
			data-action="rollMethod"
			data-type="randomChoose">Random Roll Choose Order</button>
	</div>
	<div>
		<button type="button"
			data-action="rollMethod"
			data-type="fixedValues">Fixed Values Choose Order</button>
	</div>
	<div>
		<button type="button"
			data-action="rollMethod"
			data-type="pointSpend">Point Spend</button>
	</div>
