{{! Sheet Tab Navigation }}
{{! <nav class="sheet-tabs tabs"> }}
<nav class="tabs">
  {{#each tabs as |tab|}}
    <a
      class="item control {{tab.cssClass}}"
      data-action="tab"
      data-group="{{tab.group}}"
      data-tab="{{tab.id}}"
      data-tooltip="{{localize tab.tooltip}}"
    >{{localize tab.label}}</a>
  {{/each}}
</nav>