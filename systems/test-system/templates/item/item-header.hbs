<section class="{{item.type}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <div class="left">
      <img class="item-img" src="{{item.img}}" data-action="editImage" data-edit="img" data-type="Image" alt="Item image" title="{{item.name}}" height="100" width="100"/>
      <label for="name">Name</label>
      <input type="text" id="name" name="name" class="document-name uninput" value="{{item.name}}" data-dtype="String"/>
    </div>
  </header>
</section>