<section class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <div class="left">
      <img
        class="profile-img"
        src="{{document.img}}"
        data-action="editImage"
        data-edit="img"
        data-type="Image"
        alt="Portrait"
        title="{{document.name}}"
        height="100"
        width="100"
      />
      <label for="name">Name</label>
      <input type="text" name="name" class="document-name uninput" value="{{actor.name}}" />
    </div>

    <div class="description">
      <label for="description">Description</label>
      <input type="text" name="description" class="document-name uninput" data-edit="txt" value="{{system.description}}" />
    </div>
  </header>
</section>