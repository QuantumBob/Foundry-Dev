<section class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <div class="left">
      <img
        class="profile-img"
        src="{{document.img}}"
        data-action="editImage"
        data-edit="img"
        data-type="Image"
        alt="Portrait"
        title="{{document.name}}"
        height="100"
        width="100"
      />
      <label for="name">Name</label>
      <input type="text" id="name" name="name" class="document-name uninput" value="{{actor.name}}" />
    </div>

    <div class="description">
      <label for="description">Description</label>
      <input type="text" id="description" name="description" class="document-name uninput" data-edit="txt" value="{{system.description}}" />
    </div>
    <div class="hitpoints">
      <label for="hitpoints">Hitpoints</label>
      <input type="number" id="hitpoints" name="hitpoints" class="document-name uninput" data-edit="txt" value="{{system.hitpoints}}" />
    </div>
    <div>
      {{! <input type="submit" id="submit" name="submit" class="document-name uninput" data-edit="txt" value="Submit" /> }}
    </div>
  </header>
</section>