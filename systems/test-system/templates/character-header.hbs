<section
  class="{{actor.type}} flexcol"
  autocomplete="off"
  <header class="sheet-header">
    <div>CssClass : {{part.cssClass}}, {{actor.type}}</div>
    <div class="left">
      <img
        class="profile-img"
        src="{{actor.img}}"
        data-action="editImage"
        data-edit="img"
        data-type="Image"
        alt="Portrait"
        title="{{actor.name}}"
        height="100"
        width="100"
      />
      <label for="name">Name</label>
      <input type="text" id="name" name="name" class="document-name uninput" value="{{actor.name}}" data-dtype="String" />
    </div>
    <div class="description">
      <label for="description">Description</label>
      <input
        type="text"
        id="description"
        name="system.description"
        class="document-name uninput"
        data-edit="txt"
        value="{{system.description}}"
        data-dtype="String"
      />
    </div>
    <div class="hitpoints">
      <label for="hitpoints">Hitpoints</label>
      <input
        type="number"
        id="hitpoints"
        name="system.hitpoints"
        class="document-name uninput"
        data-edit="txt"
        value="{{system.hitpoints}}"
        data-dtype="Number"
      />
    </div>
    <div>
      {{! <input type="submit" id="submit" name="submit" class="document-name uninput" data-edit="txt" value="Submit" /> }}
    </div>
  </header>
</section>