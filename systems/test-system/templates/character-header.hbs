<section class="{{actor.type}} flexcol"
	autocomplete="off">
	<header class="sheet-header">
		<div class="top">
			<div>CssClass :
				{{part.cssClass}},
				{{actor.type}}
			</div>
			<div class="left">
				<img class="profile-img"
					src="{{actor.img}}"
					{{#if editable}}
					data-action="editImage"
					{{else}}
					data-action=""
					{{/if}}
					data-edit="img"
					data-type="Image"
					alt="Portrait"
					title="{{actor.name}}"
					height="100"
					width="100" />
				<label for="name">Name</label>
				{{#if editable}}
					<input type="text"
						id="name"
						name="name"
						class="document-name uninput"
						value="{{actor.name}}"
						data-dtype="String" />
				{{else}}
					<div id="name"
						class="document-name">{{actor.name}}</div>
				{{/if}}
			</div>
			<div class="description">
				<label for="description">Description</label>
				<input type="text"
					id="description"
					name="system.description"
					class="document-name uninput"
					data-edit="txt"
					value="{{system.description}}"
					data-dtype="String" />
			</div>
			<div class="hitpoints">
				<label for="hitpoints">Hitpoints</label>
				<input type="number"
					id="hitpoints"
					name="system.hitpoints"
					class="document-name uninput"
					data-edit="txt"
					value="{{system.hitpoints}}"
					data-dtype="Number" />
			</div>
		</div>
		<div>
			<ul class="items">
				<li class="title flexrow"
					data-item-id="{{item._id}}"
					data-document-class="Item">Weapons</li>
				{{#each items.weapon as |item|}}
					<li class="item flexrow draggable"
						data-item-id="{{item._id}}"
						data-document-class="Item">
						<img src="{{item.img}}"
							title="{{item.name}}"
							width="24"
							height="24" />
						<div class="item-name">{{item.name}}</div>
						{{#if @root.editable}}
							<div class="document-controls">
								<a class="item-control item-edit"
									title="{{localize 'DOCUMENT.Update' type=item.name}}"
									data-action="viewDoc">
									<i class="fas fa-edit"></i>
								</a>
								<a class="item-control item-delete"
									title="{{localize 'DOCUMENT.Delete' type=item.name}}"
									data-action="deleteDoc">
									<i class="fas fa-trash"></i>
								</a>
						{{/if}}
		</div>
		</li>
		{{/each}}
		</ul>
		</div>
	</header>
</section>