{
  "id": "rwk-rolemaster",
  "title": "RoleMaster",
  "description": "Implimentation of the the Iron Crown RoleMaster Classic system",
  "version": "0.0.1",
  "compatibility": {
    "minimum": 12,
    "verified": 13
  },
  "authors": [
    {
      "name": "rwk"
    }
  ],
  "background": "",
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "./lang/en.json"
    }
  ],
  "esmodules": ["./rolemaster.mjs"],
  "styles": ["./rolemaster.css"],
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "socket": false,
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": ["notes.value", "notes.public", "bastion.description"]
      },
      "test actor": {
  
      }
    },
    "Item": {
      "stat generation": {
      },
      "weapon": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "resistance-roll": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "consumable": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "accessory": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "armor": {
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "race": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "background": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "profession": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "spell": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "container": {
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "backpack": {
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      }
    }
  }
}
