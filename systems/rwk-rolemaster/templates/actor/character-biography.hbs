{{! Details Tab }}
<section class="tab {{tabs.biography.id}} {{tabs.biography.cssClass}}"
	data-tab="{{tabs.biography.id}}"
	data-group="{{tabs.biography.group}}"
	id="biography">
	<div data-target="system.biography">
		<h5 class="icon">
			<i class="fas fa-feather"></i>
			<span class="rolemaster-font">{{localize "ROLEMASTER.Biography"}}</span>
		</h5>
		{{#if editable}}
			<prose-mirror name="system.biography"
				value="{{system.biography}}"
				document-uuid="{{actor.uuid}}"></prose-mirror>
		{{else}}
			<div class="editor-content">{{{enrichedBiography}}}</div>
		{{/if}}
	</div>
</section>