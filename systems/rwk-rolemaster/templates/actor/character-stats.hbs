{{! Stats Tab }}
<section class="tab {{tabs.stats.id}} {{tabs.stats.cssClass}}"
	data-tab="{{tabs.stats.id}}"
	data-group="{{tabs.stats.group}}"
	id="stats">
	<div class="{{actor.type}}-stats">
		<div class="stat-group">
			{{#each stats}}
				<div>{{@key}}: </div>
			{{/each}}
		</div>
		<div class="stat-values">
			{{#if editStats}}
				{{#each stats as | stat|}}
					<input type="text"
						class="stat-temporary"
						name="stat.temporary"
						autocomplete="off"
						class="document-name uninput"
						value="{{stat.temporary}}" />
				{{/each}}
			{{else}}
				{{#each stats as | stat|}}
					<div>{{stat.temporary}}</div>
				{{/each}}
			{{/if}}
		</div>
	</div>
	</div>

	<div>
		<ul class="items">
			{{#each items.stat-generation as |item|}}
				<li class="item flexrow draggable"
					data-item-id="{{item._id}}"
					data-document-class="Item">
					<img src="{{item.img}}"
						title="{{item.name}}"
						width="24"
						height="24" />
					<div class="item-name">{{item.name}}</div>
					{{#if @root.editable}}
						<div class="document-controls">
							<a class="item-control item-edit"
								title="{{localize 'DOCUMENT.Update' type=item.name}}"
								data-action="viewDoc"
								data-item-id="{{item._id}}"
								data-document-class="Item">
								<i class="fas fa-edit"></i>
							</a>
							<a class="item-control item-delete"
								title="{{localize 'DOCUMENT.Delete' type=item.name}}"
								data-action="deleteStatGen"
								data-item-id="{{item._id}}"
								data-document-class="Item">
								<i class="fas fa-trash"></i>
							</a>
					{{/if}}
	</div>
	</li>
	{{/each}}
	</ul>
</section>
{{! End Stats Tab }}